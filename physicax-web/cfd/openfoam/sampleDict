/* Sample dictionary for OpenFOAM */
sample
{
    type            sets;
    libs            ("libsampling.so");
    interpolationScheme cellPoint;
    setFormat       csv;

    fields          (U p);

    sets
    (
        uniformGrid
        {
            type        boxUniform;
            box         (-4 -2 -2) (4 2 2);
            nPoints     (24 16 16);
        }
    );
}
