generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String?
  image     String?
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bio       String?
  level     String      @default("student")
  language  String      @default("en")
  interests String?
  favoriteLabs String?
  visibility String     @default("private")
  role      String      @default("user")
  accounts  Account[]
  sessions  Session[]
  experiments Experiment[]
  publications Publication[]
  collections ExperimentCollection[]
  presets   Preset[]
  researchRuns ResearchRun[]
  challenges Challenge[]
  assignments Assignment[]
  classrooms Classroom[] @relation("ClassroomOwner")
  comments  PublicationComment[]
  likes     PublicationLike[]
  folders   ExperimentFolder[]
  tags      ExperimentTag[]
  assets    ExperimentAsset[]
  notebooks Notebook[]
  classroomMembers ClassroomMember[]
  submissions Submission[]
  challengeProgress ChallengeProgress[]
  badges UserBadge[]
  challengeSets ChallengeSet[]
}

model Experiment {
  id         String   @id @default(cuid())
  title      String
  model      String
  inputs     String
  outputs    String
  notes      String?
  tags       String?
  visibility String   @default("private")
  version    Int      @default(1)
  parentId   String?
  collectionId String?
  folderId   String?
  forkedFromId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  parent     Experiment? @relation("ExperimentVersions", fields: [parentId], references: [id])
  versions   Experiment[] @relation("ExperimentVersions")
  collection ExperimentCollection? @relation(fields: [collectionId], references: [id])
  folder     ExperimentFolder? @relation(fields: [folderId], references: [id])
  tagLinks   ExperimentTagMap[]
  assets     ExperimentAsset[]
}

model Publication {
  id         String   @id @default(cuid())
  title      String
  model      String
  inputs     String
  outputs    String
  notes      String?
  tags       String?
  createdAt  DateTime @default(now())
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  likesCount Int      @default(0)
  featured   Boolean  @default(false)
  trendingScore Float @default(0)
  comments   PublicationComment[]
  likes      PublicationLike[]
}

model ExperimentCollection {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  experiments Experiment[]
}

model Preset {
  id        String   @id @default(cuid())
  title     String
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model PublicationComment {
  id            String   @id @default(cuid())
  content       String
  createdAt     DateTime @default(now())
  authorId      String?
  publicationId String
  author        User?    @relation(fields: [authorId], references: [id])
  publication   Publication @relation(fields: [publicationId], references: [id])
}

model PublicationLike {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  userId        String
  publicationId String
  user          User     @relation(fields: [userId], references: [id])
  publication   Publication @relation(fields: [publicationId], references: [id])

  @@unique([userId, publicationId])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  prompt      String
  difficulty  String   @default("medium")
  answerType  String   @default("numeric")
  expected    String?
  hint        String?
  createdAt   DateTime @default(now())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  setId       String?
  set         ChallengeSet? @relation(fields: [setId], references: [id])
  progress    ChallengeProgress[]
}

model ChallengeSet {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  challenges  Challenge[]
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  rubric      String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  authorId    String?
  classroomId String?
  author      User?    @relation(fields: [authorId], references: [id])
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  submissions Submission[]
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  ownerId     String
  owner       User     @relation("ClassroomOwner", fields: [ownerId], references: [id])
  members     ClassroomMember[]
  assignments Assignment[]
}

model ClassroomMember {
  id          String   @id @default(cuid())
  role        String   @default("student")
  createdAt   DateTime @default(now())
  classroomId String
  userId      String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
}

model Submission {
  id           String   @id @default(cuid())
  payload      String
  score        Float?
  createdAt    DateTime @default(now())
  assignmentId String
  userId       String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model ChallengeProgress {
  id          String   @id @default(cuid())
  attempts    Int      @default(0)
  bestScore   Float?
  completed   Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  userId      String
  challengeId String
  user        User     @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model ResearchRun {
  id        String   @id @default(cuid())
  title     String
  model     String
  params    String
  results   String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ExperimentFolder {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  experiments Experiment[]
}

model ExperimentTag {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  links     ExperimentTagMap[]

  @@unique([label, userId])
}

model ExperimentTagMap {
  id           String   @id @default(cuid())
  experimentId String
  tagId        String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  tag          ExperimentTag @relation(fields: [tagId], references: [id])

  @@unique([experimentId, tagId])
}

model ExperimentAsset {
  id           String   @id @default(cuid())
  title        String
  path         String
  mime         String?
  metadata     String?
  createdAt    DateTime @default(now())
  experimentId String?
  userId       String
  experiment   Experiment? @relation(fields: [experimentId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Notebook {
  id        String   @id @default(cuid())
  title     String
  content   String
  links     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model SearchIndexEntry {
  id        String   @id @default(cuid())
  title     String
  href      String
  category  String
  summary   String
  tags      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
