{
  "name": "physicax-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PhysicaX desktop shell with optional offline AI tutor.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "build": {
    "appId": "com.physicax.app",
    "productName": "PhysicaX",
    "files": [
      "electron/**/*",
      "ai-backend/**/*",
      "scripts/**/*",
      "index.html",
      "styles.css",
      "script.js",
      "PhysicaX_Formula_Reference.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PhysicaX-${version}-${arch}.${ext}",
      "sign": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "PhysicaX-${version}-${arch}.${ext}"
    },
    "publish": null,
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.9.1"
  }
}
